# Database
POSTGRES_USER=iguest
POSTGRES_PASSWORD=iguest
POSTGRES_DB=iguest
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Google AI Studio â€” get your key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_BATCH_SIZE=100
GENERATION_MODEL=models/gemini-2.5-flash
GENERATION_TEMPERATURE=0.2

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# RAG retrieval
RAG_TOP_K=10

# FAQ / question analytics
FAQ_QUESTION_DISTANCE=0.18
FAQ_CATEGORY_DISTANCE=0.40
FAQ_TOP_N=5
FAQ_MIN_TO_SHOW=3
# Automatic scheduled recompute of question clusters/analytics/FAQ answers
# (runs inside the backend; scripts/recompute_faqs.py is still available to
# run it manually/on demand, e.g. right after a bulk of test questions)
FAQ_RECOMPUTE_ENABLED=true
FAQ_RECOMPUTE_INTERVAL_SECONDS=300

# Guest conversations / GDPR retention
CONVERSATION_RETENTION_DAYS=30
# Automatic scheduled purge of expired conversations (runs inside the backend)
RETENTION_PURGE_ENABLED=true
RETENTION_PURGE_INTERVAL_SECONDS=86400

# Admin authentication (single administrator) â€” DO NOT use these defaults in production
ADMIN_USERNAME=iguest
ADMIN_PASSWORD=iguest
# Generate a long random secret, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
ADMIN_JWT_SECRET=generate_a_long_random_secret_here
ADMIN_TOKEN_EXPIRE_MINUTES=720

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
MAX_DOCUMENT_UPLOAD_BYTES=20971520

# CORS â€” frontend origin(s), comma-separated
CORS_ORIGINS=http://localhost:5174

# Visit-request notifications (landing "book a visit" leads) â€” all optional.
# Leave blank to just store leads and read them in the admin inbox (demo mode).
VISIT_REQUEST_NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
